{
  "name": "storyhelper",
  "version": "1.7.3",
  "description": "티스토리 확장프로그램 StoryHelper",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ShipFriend0516/StoryHelper.git"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "build:firefox": "tsc --noEmit && cross-env __FIREFOX__=true vite build",
    "build:watch": "cross-env __DEV__=true vite build -w --mode development",
    "build:firefox:watch": "cross-env __DEV__=true __FIREFOX__=true vite build -w --mode development",
    "build:hmr": "rollup --config utils/reload/rollup.config.mjs",
    "wss": "node utils/reload/initReloadServer.js",
    "dev": "pnpm build:hmr && (run-p wss build:watch)",
    "dev:firefox": "pnpm build:hmr && (run-p wss build:firefox:watch)",
    "test": "vitest",
    "commitlint": "commitlint --edit",
    "lint": "eslint src --ext .ts,.js,.tsx,.jsx",
    "lint:fix": "pnpm lint --fix",
    "prettier": "prettier . --write",
    "prepare": "husky install"
  },
  "type": "module",
  "dependencies": {
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "webextension-polyfill": "0.12.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@rollup/plugin-sucrase": "^5.1.0",
    "@rollup/plugin-typescript": "12.3.0",
    "@testing-library/react": "16.3.3",
    "@types/chrome": "0.0.278",
    "@types/node": "^22.20.5",
    "@types/react": "18.2.37",
    "@types/react-dom": "18.2.18",
    "@types/ws": "8.18.2",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "@vitejs/plugin-react": "4.3.4",
    "chokidar": "3.5.3",
    "cross-env": "10.1.0",
    "eslint": "8.56.0",
    "eslint-config-airbnb-typescript": "17.1.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "4.6.0",
    "fs-extra": "11.4.1",
    "husky": "9.1.7",
    "jsdom": "^22.1.0",
    "lint-staged": "15.3.0",
    "magic-string": "^0.30.21",
    "npm-run-all": "4.1.5",
    "prettier": "3.9.10",
    "rollup": "4.64.7",
    "sass": "1.105.1",
    "ts-loader": "9.6.2",
    "tslib": "2.8.1",
    "typescript": "5.4.5",
    "vite": "5.4.3",
    "vitest": "^2.1.9",
    "ws": "8.22.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "packageManager": "pnpm@10.11.0"
}
